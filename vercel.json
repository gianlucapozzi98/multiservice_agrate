{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- public/ vercel.json api/",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/i-nostri-lavori",
      "destination": "/lavori/",
      "permanent": true
    },
    {
      "source": "/i-nostri-lavori/",
      "destination": "/lavori/",
      "permanent": true
    },
    {
      "source": "/cantiere-villa-burago",
      "destination": "/lavori/burago-di-molgora/",
      "permanent": true
    },
    {
      "source": "/cantiere-villa-burago/",
      "destination": "/lavori/burago-di-molgora/",
      "permanent": true
    },
    {
      "source": "/cantiere-agrate-brianza",
      "destination": "/lavori/agrate-brianza-via-matteotti/",
      "permanent": true
    },
    {
      "source": "/cantiere-agrate-brianza/",
      "destination": "/lavori/agrate-brianza-via-matteotti/",
      "permanent": true
    },
    {
      "source": "/cantiere-milano",
      "destination": "/lavori/milano/",
      "permanent": true
    },
    {
      "source": "/cantiere-milano/",
      "destination": "/lavori/milano/",
      "permanent": true
    },
    {
      "source": "/cantiere-merate",
      "destination": "/lavori/merate/",
      "permanent": true
    },
    {
      "source": "/cantiere-merate/",
      "destination": "/lavori/merate/",
      "permanent": true
    },
    {
      "source": "/cantiere-monza-corso-milano",
      "destination": "/lavori/monza-corso-milano/",
      "permanent": true
    },
    {
      "source": "/cantiere-monza-corso-milano/",
      "destination": "/lavori/monza-corso-milano/",
      "permanent": true
    },
    {
      "source": "/cantiere-viotti-monza",
      "destination": "/lavori/monza-via-viotti/",
      "permanent": true
    },
    {
      "source": "/cantiere-viotti-monza/",
      "destination": "/lavori/monza-via-viotti/",
      "permanent": true
    },
    {
      "source": "/cantiere-cantu",
      "destination": "/lavori/",
      "permanent": true
    },
    {
      "source": "/cantiere-cantu/",
      "destination": "/lavori/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/comments/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/comments/feed/",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; manifest-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
